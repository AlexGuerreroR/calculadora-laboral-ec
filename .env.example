# Copie este archivo como .env y ponga SUS claves. El .env NUNCA se sube a GitHub.
# Cada integrante usa su propia clave y su propio proyecto (los límites de Gemini son por proyecto).
# Claves gratuitas: Gemini -> https://aistudio.google.com/apikey · Groq -> https://console.groq.com/keys

# Proveedor principal y de respaldo (gemini | groq | simulado) · ADR-001
# (el kit también acepta los nombres de la plantilla de la clase 1: LLM_PROVIDER,
#  LLM_FALLBACK_PROVIDER, LLM_MODEL, LLM_TIMEOUT_SECONDS...; una línea vacía usa el valor por defecto)
LLM_PRINCIPAL=groq
LLM_RESPALDO=gemini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Límites de cada llamada (se ajustan con lo medido en la comparación de prompts)
LLM_TIMEOUT_S=15
LLM_MAX_TOKENS=2048
LLM_REINTENTOS=2
# Cuánto «piensa» el modelo: low | medium | high. Se usa en lugar de la temperatura (ver docs/03-arquitectura.md).
LLM_RAZONAMIENTO=low

# Límites del backend (docs/03-arquitectura.md)
MAX_INPUT_CHARS=2000
RATE_LIMIT_POR_MINUTO=4

# Semana 3 (RAG): base vectorial con el Código del Trabajo (scripts/ingest.py)
# Modelo de embeddings del RAG: debe entender español (nunca el de ChromaDB por defecto).
# Si se cambia, hay que volver a correr scripts/ingest.py.
EMBEDDING_MODEL=intfloat/multilingual-e5-small
CHROMA_PATH=./data/chroma-2026

# Frontend servido por FastAPI (CORS)
ALLOWED_ORIGINS=http://localhost:8000
